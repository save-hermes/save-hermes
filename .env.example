# === Evolution API (WhatsApp) ===
# Base pública da sua Evolution (SEM barra no final)
EVOLUTION_URL=https://marketing-evolution-api.icoeqn.easypanel.host
# Nome da instância que segura o número
EVOLUTION_INSTANCE=educacao_teste
# Chave da Evolution (a "API Key Global" do Manager, ou o token da instância).
# Cole aqui NO EASYPANEL, não no código.
EVOLUTION_API_KEY=coloque_sua_api_key_da_evolution_aqui

# === Claude (Anthropic) ===
ANTHROPIC_API_KEY=sk-ant-coloque_sua_chave_aqui
# Modelo — confirme o id disponível no seu console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Limite de tokens por resposta
ANTHROPIC_MAX_TOKENS=1024

# === Segurança do webhook ===
# Um segredo qualquer que VOCÊ inventa. Ele entra na URL do webhook (?token=...)
# e o serviço rejeita qualquer POST sem ele. Gere algo longo e aleatório.
WEBHOOK_TOKEN=troque_por_um_segredo_longo_e_aleatorio

# Comportamento do agente
AGENT_NAME=Vanessa
# Seu número para receber avisos de "lead quente / assumir conversa"
# Formato internacional sem +, ex.: 5511999998888. Deixe vazio para desativar.
OWNER_NOTIFY_NUMBER=
# Número do administrador/superior (canal de bastidor). SÓ este número pode ajustar
# comportamento/tom/regras. Qualquer outro é tratado como atendimento, mesmo que
# alegue ser admin. Formato só dígitos, ex.: 5547996810630.
ADMIN_NUMBER=
# Atraso simulado de digitação (ms) antes de enviar — deixa mais humano
SEND_DELAY_MS=1200

# === Aquecimento (warming) — reduz risco de ban ===
# Máx. de mensagens que a Vanessa envia por dia. Número NOVO: comece em ~30 e suba
# gradual ao longo de semanas. 0 = sem limite.
DAILY_SEND_LIMIT=40
# Jitter aleatório extra (ms) somado ao SEND_DELAY_MS, p/ ritmo humano.
SEND_JITTER_MIN_MS=800
SEND_JITTER_MAX_MS=3500
# Link de checkout/pagamento do curso (a IA envia para fechar a venda)
CHECKOUT_URL=
# Caminho do banco (no container). Não precisa mudar.
DB_PATH=/data/leads.db

# === Base de conhecimento de produtos ===
# Pasta com as notas .md de produto (fonte da verdade p/ preço, garantia etc.).
# Ex. local (vault Obsidian): C:\Users\voce\Documents\...\Produtos da save Educação
# No Easypanel, monte um volume e aponte aqui.
KB_DIR=

# === Instagram (Meta Graph API) — canal DMs + comentários ===
# Token de acesso de longa duração (Page/IG). developers.facebook.com
IG_ACCESS_TOKEN=
# ID numérico da conta Instagram Business (IG User ID).
IG_USER_ID=
# Token de verificação do webhook (VOCÊ inventa; a Meta ecoa no handshake).
IG_VERIFY_TOKEN=
# App Secret da Meta (valida a assinatura X-Hub-Signature-256 dos webhooks).
IG_APP_SECRET=
# Versão da Graph API.
IG_GRAPH_VERSION=v23.0
# Como responder comentários: public (só no comentário) | dm (só private reply) |
# both (comentário curto + DM com detalhe). Padrão: both.
IG_COMMENT_MODE=both

# === E-mail (Google Workspace via SMTP/IMAP) — canal e-mail + follow-up ===
# Endereço que a Vanessa usa para enviar/receber. Ex.: vanessa@saveeducacao.com.br
EMAIL_ADDRESS=
# Nome exibido no "De:". Padrão: "Vanessa | Save Educação".
EMAIL_FROM_NAME=Vanessa | Save Educação
# Senha de App do Google (16 caracteres) — myaccount.google.com/apppasswords.
# NÃO é a senha normal; exige verificação em 2 etapas ativada. Cole aqui, nunca no código.
EMAIL_APP_PASSWORD=
# Servidores (padrões do Google Workspace / Gmail — normalmente não mude).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Assinatura no rodapé dos e-mails (texto puro; use \n para quebra de linha).
EMAIL_SIGNATURE=Vanessa\nSave Educação
# Limite diário de e-mails enviados (deliverability/anti-spam). 0 = sem limite.
EMAIL_DAILY_LIMIT=50

# === Resend (provedor de ENVIO — opcional, recomendado p/ deliverability) ===
# Se preenchida, o ENVIO usa a API do Resend (logs de entrega/abertura no painel).
# Vazio = envia pelo SMTP da caixa acima. A LEITURA é sempre por IMAP. resend.com/api-keys
RESEND_API_KEY=
# Remetente no Resend (precisa ser de um domínio VERIFICADO no Resend).
# Vazio = usa EMAIL_ADDRESS. Ex.: Vanessa | Save Educação <vanessa@saveeducacao.com.br>
RESEND_FROM=

# === Follow-up (cadência de acompanhamento) ===
# Liga/desliga o motor de follow-up (WhatsApp + e-mail).
FOLLOWUP_ENABLED=true
# Cadência clássica em HORAS após o último contato sem resposta: dia1,dia3,dia7.
FOLLOWUP_HOURS=24,72,168
# Só dispara follow-up dentro deste horário (evita mandar de madrugada). 24h local.
FOLLOWUP_HOUR_START=9
FOLLOWUP_HOUR_END=20
