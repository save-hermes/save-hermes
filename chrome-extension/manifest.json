{
  "manifest_version": 3,
  "name": "Vanessa — Atendente IA (WhatsApp Web)",
  "version": "0.1.0",
  "description": "Lê mensagens novas no WhatsApp Web, consulta o agente Vanessa e responde automaticamente. Uso supervisionado.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vanessa — Atendente IA"
  },
  "icons": {}
}
